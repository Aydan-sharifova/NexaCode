# Copy to .env and replace every CHANGE_ME value. Never commit .env.
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080
ALLOWED_HOSTS=localhost
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
SHOWCASE_DOMAIN=yourdomain.com

POSTGRES_DB=coding
POSTGRES_USER=coding
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

JWT_ISSUER=Coding.Api
JWT_AUDIENCE=Coding.Frontend
# Generate with: openssl rand -base64 48
JWT_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_BYTES

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=NexaCode

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_MAX_OUTPUT_TOKENS=4096

# Local/provider-independent AI selection.
AI_PROVIDER=OpenAI
OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1/
OPENAI_COMPATIBLE_MODEL=qwen2.5-coder:1.5b
OPENAI_COMPATIBLE_VISION_MODEL=aydan-vision
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MAX_OUTPUT_TOKENS=2048
OPENAI_COMPATIBLE_TEMPERATURE=0.1

# Production external URLs (used by hosting providers, not server secrets).
API_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
SHOWCASE_URL=https://yourdomain.com

# Optional registry image overrides.
API_IMAGE=coding-api:1.0.0
FRONTEND_IMAGE=coding-frontend:1.0.0
