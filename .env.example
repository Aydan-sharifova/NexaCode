POSTGRES_DB=coding
POSTGRES_USER=coding
POSTGRES_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
SignalR__UseRedisBackplane=false
JWT_ISSUER=Coding.Api
JWT_AUDIENCE=Coding.Frontend
JWT_KEY=replace-with-a-random-secret-at-least-32-bytes
FRONTEND_ORIGIN=http://localhost:8080
ALLOWED_HOSTS=localhost
FRONTEND_PORT=8080
RepositoryStorage__RootPath=App_Data/repositories

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
SMTP_CHECK_CERTIFICATE_REVOCATION=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NexaCode

AI_PROVIDER=Ollama
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1/
OPENAI_COMPATIBLE_MODEL=qwen2.5-coder:1.5b
OPENAI_COMPATIBLE_VISION_MODEL=aydan-vision
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MAX_OUTPUT_TOKENS=2048
OPENAI_COMPATIBLE_TEMPERATURE=0.1

# Local development only. Production must use a dedicated isolated worker.
EXECUTION_ENABLED=false
EXECUTION_DOTNET_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0
