{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nexacode-g8dj.onrender.com/api/:path*"
    },
    {
      "source": "/hubs/:path*",
      "destination": "https://nexacode-g8dj.onrender.com/hubs/:path*"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
