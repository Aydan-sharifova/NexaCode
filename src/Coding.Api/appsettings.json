    "DemoEmail": "demo@coding.local",
    "DemoPassword": ""
  },
  "DemoMode": {
    "Enabled": false,
    "DatabaseNameMarker": "Demo",
    "AccessTokenMinutes": 20,
    "RefreshTokenHours": 2,
    "ResetIntervalMinutes": 60,
    "MaxUploadBytes": 1048576,
    "BlockedFileExtensions": [
      ".app",
      ".bat",
      ".cmd",
      ".com",
      ".dll",
      ".dmg",
      ".exe",
      ".jar",
      ".msi",
      ".pkg",
