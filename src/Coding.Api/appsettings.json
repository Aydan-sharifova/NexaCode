  "Smtp": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "NexaCode",
    "ClientBaseUrl": "http://localhost:5173",
    "UseSsl": false,
    "UseStartTls": true,
    "CheckCertificateRevocation": true
  },
  "AI": {
    "Provider": "Development"
  },
  "OpenAICompatible": {
    "BaseUrl": "http://localhost:11434/v1/",
    "Model": "qwen2.5-coder:1.5b",
    "VisionModel": "aydan-vision",
    "ApiKey": "ollama",
